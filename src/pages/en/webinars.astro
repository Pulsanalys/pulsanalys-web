---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import DateList from "../../components/DateList.astro";
---

<Base title="Webinars | PulsAnalys DISC" description="Free inspirational lectures and webinars about DISC. How do you communicate with your managers and colleagues?">
  <PageHero heading="Webinars" lead="Our lecturer Mia Wernersson talks about DISC and the personality colours for better communication. You get tips and experience on how to think when you meet other people at work." crumb={{ href: "/en/courses-and-lectures/", label: "Courses and lectures" }} />
  <section class="section">
    <div class="wrap">
      <DateList types={["forelasning"]} empty="New lectures are published here. Contact us if you would like us to give a lecture at your organisation." />
      <p class="more"><a class="text-link" href="/en/consulting-services/">Lectures tailored to your organisation</a></p>
    </div>
  </section>
  <CtaBand />
</Base>

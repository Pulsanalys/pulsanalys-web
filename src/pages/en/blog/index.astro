---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";

const posts = (await getCollection("posts")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Base title="Blog and newsletters | PulsAnalys DISC" description="News and newsletters from PulsAnalys AB, in Swedish.">
  <PageHero heading="Blog" lead="News and newsletters from PulsAnalys. The posts are written in Swedish." />
  <section class="section">
    <div class="wrap">
      <ul class="feature-grid">
        {posts.map((p) => (
          <li class="feature">
            {p.data.photo && (
              <div class="photo">
                <Picture src={p.data.photo} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 60rem) 40vw, 100vw" alt={p.data.alt ?? ""} />
              </div>
            )}
            <div class="feature-body">
              <p class="meta"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt.format(p.data.date)}</time></p>
              <h2 lang="sv">{p.data.title}</h2>
              <p lang="sv">{p.data.summary}</p>
              <a class="text-link" href={`/blogg/${p.id}/`} hreflang="sv">Read the post<span class="visually-hidden"> {p.data.title}</span></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

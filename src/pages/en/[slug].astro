---
import { getCollection } from "astro:content";
import ContentPage from "../../components/ContentPage.astro";
import type { ContentItem } from "../../lib/content-item.ts";

export async function getStaticPaths() {
  const [products, courses, pages] = await Promise.all([
    getCollection("products"), getCollection("courses"), getCollection("pages"),
  ]);
  const en = (id: string) => id.startsWith("en/");
  return [
    ...products.filter((e) => en(e.id)).map((entry) => ({ params: { slug: entry.id.slice(3) }, props: { item: { kind: "product", entry } } })),
    ...courses.filter((e) => en(e.id)).map((entry) => ({ params: { slug: entry.id.slice(3) }, props: { item: { kind: "course", entry } } })),
    ...pages.filter((e) => en(e.id)).map((entry) => ({ params: { slug: entry.id.slice(3) }, props: { item: { kind: "page", entry } } })),
  ];
}
const { item } = Astro.props as { item: ContentItem };
---

<ContentPage item={item} />

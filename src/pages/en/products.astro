---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import lecturePhoto from "../../assets/photos/forelasning.jpg";

const products = (await getCollection("products")).filter((p) => p.id.startsWith("en/")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Products – four DISC profiles | PulsAnalys DISC"
  description="Communication tools and profiles: Personal Profile, Team Profile, Recruitment Profile, 360 Profile and our consulting services.">
  <PageHero heading="Four profiles, one shared language"
    lead="Every product builds on the same Personal Profile. With a subscription you create an unlimited number of profiles in all four – or our consultants create them for you." />
  <section class="section">
    <div class="wrap">
      <ul class="feature-grid">
        {products.map((p) => (
          <li class="feature">
            <div class="photo">
              <Picture src={p.data.photo} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 60rem) 40vw, 100vw" alt={p.data.alt} />
            </div>
            <div class="feature-body">
              <h2>{p.data.title}</h2>
              <p>{p.data.summary}</p>
              <a class="text-link" href={`/en/${p.id.slice(3)}/`}>Read about the {p.data.title}</a>
            </div>
          </li>
        ))}
        <li class="feature">
          <div class="photo">
            <Picture src={lecturePhoto} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 60rem) 40vw, 100vw" alt="An audience listening to a lecture about DISC." />
          </div>
          <div class="feature-body">
            <h2>Consulting services</h2>
            <p>Our consultants have many years of experience and broad expertise. We help with anything from a few hours to larger projects, and tailor a solution for your organisation.</p>
            <a class="text-link" href="/en/consulting-services/">Read about our consulting services</a>
          </div>
        </li>
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>

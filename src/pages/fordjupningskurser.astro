---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import DateList from "../components/DateList.astro";
---

<Base title="Fördjupningskurser DISC | PulsAnalys DISC" description="Kommande fördjupningskurser för dig som är certifierad i PulsAnalys DISC. Välj ett datum och anmäl dig.">
  <PageHero heading="Fördjupningskurser DISC" lead="För dig som har gått grundutbildningen och är certifierad i PulsAnalys DISC. Välj ett datum för att läsa mer och anmäla dig." crumb={{ href: "/utbildningar-och-forelasningar/", label: "Utbildningar och föreläsningar" }} />
  <section class="section">
    <div class="wrap">
      <DateList types={["fordjupningskurs"]} empty="Det finns inga inbokade fördjupningskurser just nu. Kontakta oss så berättar vi när nästa kurs startar." />
      <p class="more"><a class="text-link" href="/fordjupning-disc/">Om Fördjupning DISC</a></p>
    </div>
  </section>
  <CtaBand />
</Base>

---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import ProfileGraph from "../components/ProfileGraph.astro";
import { toBookable, upcomingEvents } from "../lib/events.ts";

import teamPhoto from "../assets/photos/team-vid-bordet.jpg";
import lecturePhoto from "../assets/photos/forelasning.jpg";
import cardsPhoto from "../assets/photos/disc-kort.jpg";
import personPhoto from "../assets/photos/personprofil.jpg";
import teamProfilePhoto from "../assets/photos/teamprofil.jpg";
import recruitPhoto from "../assets/photos/rekryteringsprofil.jpg";
import threeSixtyPhoto from "../assets/photos/360-profil.jpg";

import azLogo from "../assets/logos/astrazeneca.png";
import jeLogo from "../assets/logos/jonkoping-energi.jpeg";
import ffLogo from "../assets/logos/finansforbundet.png";
import icaLogo from "../assets/logos/ica-maxi.png";
import ox2Logo from "../assets/logos/ox2.png";
import barillaLogo from "../assets/logos/barilla.png";

const events = (await upcomingEvents()).map(toBookable);
const courses = events.filter((e) => e.slug.startsWith("grundutbildning") || e.slug.startsWith("fordjupning"));

const products = [
  {
    name: "Personprofil",
    href: "/personprofil/",
    photo: personPhoto,
    alt: "En hand håller en mobiltelefon med en personprofil på skärmen.",
    text: "Personprofilen synliggör en persons framträdande styrkor, hur personen tenderar att agera i olika situationer och hur hen anpassar sig till krav och förväntningar. Den är grunden för PulsAnalys och används bland annat i personlig utveckling, coaching, ledarskapsutveckling och kommunikationsträning.",
  },
  {
    name: "Teamprofil",
    href: "/teamprofil/",
    photo: teamProfilePhoto,
    alt: "En bärbar dator visar flera profilgrafer bredvid en mobiltelefon och en kopp kaffe.",
    text: "Teamprofilen samlar gruppens personprofiler i en tydlig graf som kan jämföras med en gemensam kravprofil. Hur använder vi våra styrkor som team, och vad behöver vi arbeta med för att nå våra mål?",
  },
  {
    name: "Rekryteringsprofil",
    href: "/rekryteringsprofil/",
    photo: recruitPhoto,
    alt: "Två kollegor sitter i en soffa och går igenom ett underlag på en bärbar dator.",
    text: "Rekryteringsprofilen gör företagets behov synliga utifrån de egenskaper som redan finns i arbetsgruppen. Kandidaternas personprofiler kan sedan matchas mot den bilden.",
  },
  {
    name: "360-profil",
    href: "/360-profil/",
    photo: threeSixtyPhoto,
    alt: "Händer sätter upp gula lappar med anteckningar på en vägg.",
    text: "360-profilen visar hur andra uppfattar en persons beteende och öppnar för samtal om hur kollegor ser på dina styrkor. Ett verktyg för feedback, teamutveckling och konflikthantering – och för referenstagning och chefsbedömning vid rekrytering.",
  },
];

const clients = [
  { src: azLogo, alt: "AstraZeneca" },
  { src: jeLogo, alt: "Jönköping Energi" },
  { src: ffLogo, alt: "Finansförbundet" },
  { src: icaLogo, alt: "ICA Maxi" },
  { src: barillaLogo, alt: "Barilla" },
  { src: ox2Logo, alt: "OX2" },
];

const quotes = [
  { text: "Förutom Pulsprofiler i olika sammanhang som del av utveckling av team/chefer har vi fokuserat på PulsAnalys 360 i våra Development center – ett assessment för blivande Sektionschefer. Superbra komplement till case och övningar.", name: "Mikael Hansen", org: "AstraZeneca" },
  { text: "PulsAnalys är ett enkelt och lättanvänt redskap som hjälper oss att rekrytera rätt person till rätt plats. PulsAnalys hjälper oss att förbättra kommunikationen i företaget samt identifiera utvecklingsområden hos våra medarbetare.", name: "Pia Antill", org: "Birka Cruises AB" },
  { text: "Vi har under 5 års tid anlitat PulsAnalys angående personprofiler och egenskaper för att skapa starka självständiga team och vi märker tydligt att personerna får en ökad förståelse om sina kollegor och sig själva samt vad teamet behöver för att bli effektivare.", name: "Tommy Smedberg", org: "Wästbygg" },
  { text: "PulsAnalys erbjuder ett bra hjälpmedel vid rekrytering. Det är lätt att använda, intressant och ger ökad förståelse för hur andra reagerar och agerar. Verktyget lyfter fram personens starka sidor.", name: "Inger Eriksson", org: "Eckerö Rederi AB" },
  { text: "PulsAnalys är ett enkelt och funktionellt verktyg som ger ett kompletterande samtalsunderlag vid rekrytering och teamutveckling av personal. Skapar en djupare dialog och förståelse för personens styrkor och svagheter.", name: "Linnéa Persson", org: "Faiveley Transport Nordic AB" },
  { text: "Utbildningen i PulsAnalys DISC har för mig inneburit ett helt nytt sätt att kunna identifiera personers styrkor och hur olika egenskaper behövs för att skapa ett effektivt team.", name: "Robert Hallgren", org: "The Generation AB" },
  { text: "Jag ville ha ett enkelt och digitalt verktyg i mitt arbete som HR-konsult och Executive Coach. PulsAnalys bidrar till förstärkt kommunikation i organisationer samt att verktyget lyfter olika styrkor hos individen.", name: "Jessica Hill Holm", org: "Hill Holm Coaching & Consulting" },
  { text: "Vi fick värdefulla insikter och verktyg för att vi som grupp kunde arbeta framåt och på bästa sätt ta oss an våra uppsatta mål utifrån våra styrkor.", name: "Linda Hanserius", org: "Järfälla kommun" },
];
---

<Base title="PulsAnalys DISC – ett kommunikationsverktyg som förenklar vardagen"
  description="PulsAnalys visar beteendemönster utifrån DISC-teorin. Personprofil, teamprofil, rekryteringsprofil och 360-profil, utbildning och certifiering i DISC.">

  <section class="hero" aria-labelledby="hero-rubrik">
    <div class="wrap hero-grid">
      <h1 id="hero-rubrik">Ett kommunikations&shy;verktyg som förenklar vardagen</h1>
      <div class="hero-side">
        <p class="lead">PulsAnalys visar beteendemönster utifrån DISC-teorin. Ett enkelt verktyg för att förstå sig själv och varandra bättre på jobbet.</p>
        <div class="actions">
          <a class="button" href="/utbildningar-och-forelasningar/">Se kommande utbildningar</a>
          <a class="text-link" href="/vad-ar-pulsanalys/">Så fungerar PulsAnalys</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="photo hero-photo">
        <Picture src={teamPhoto} formats={["avif", "webp"]} widths={[640, 960, 1320, 1980]}
          sizes="(min-width: 1440px) 1320px, calc(100vw - 2 * clamp(1.25rem, 5vw, 4rem))"
          alt="Fyra kollegor står lutade över ett bord och studerar profilgrafer tillsammans."
          loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <ProfileGraph />

  <section class="section" aria-labelledby="steg-rubrik">
    <div class="wrap">
      <header class="section-head">
        <h2 id="steg-rubrik">Tre steg till bättre kommunikation</h2>
        <p class="lead">Att förstå varandra är svårt. Att förstå varandra på jobbet är ännu svårare. Så här kommer du och ditt företag igång med PulsAnalys.</p>
      </header>
      <ol class="step-list">
        <li>
          <h3>Grundutbildning DISC</h3>
          <p>För att själv kunna använda verktyget går du vår grundutbildning. Vi lägger stor vikt vid återkopplingen – målet är att utveckla och lyfta människor.</p>
        </li>
        <li>
          <h3>Certifiering</h3>
          <p>I utbildningen ingår tio profiler att träna på. När du har klarat certifieringen kan du använda alla våra verktyg i systemet.</p>
        </li>
        <li>
          <h3>Abonnemang</h3>
          <p>Välj ett abonnemang som passar dig och ditt företag. Du gör ett obegränsat antal profiler i alla våra produkter.</p>
        </li>
      </ol>
      <p class="more"><a class="text-link" href="/vad-ar-pulsanalys/">Läs mer om de tre stegen</a></p>
    </div>
  </section>

  <section class="section tint" aria-labelledby="kurs-rubrik">
    <div class="wrap split">
      <div class="photo split-media">
        <Picture src={cardsPhoto} formats={["avif", "webp"]} widths={[480, 720, 1000]}
          sizes="(min-width: 60rem) 40vw, 100vw"
          alt="Färgade kort med orden pådrivande, utåtriktad, lyhörd och systematisk ligger på ett bord bredvid en kurspärm." />
      </div>
      <div class="split-text">
        <h2 id="kurs-rubrik">Utbildning i DISC för framtida chefer, konsulter och rekryterare</h2>
        <p class="lead">För att själv arbeta med PulsAnalys DISC erbjuder vi grundutbildning och fördjupningsutbildning. Med kurserna och ett abonnemang skapar du själv profiler och använder alla våra produkter.</p>
        <h3 class="list-title">Kommande kurser</h3>
        {courses.length > 0 ? (
          <ul class="dates">
            {courses.map((e) => (
              <li>
                <a href={`/utbildningar-och-forelasningar/${e.slug}/`}>
                  <span class="date">{e.dateLabel}</span>
                  <span class="what">{e.title}<span class="where">{e.place}, kl. {e.time}</span></span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>Nya datum publiceras snart. Kontakta oss så berättar vi när nästa kurs startar.</p>
        )}
        <p class="more"><a class="text-link" href="/kurser/">Om kurserna</a><a class="text-link" href="/utbildningar-och-forelasningar/">Alla datum</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="produkt-rubrik">
    <div class="wrap">
      <header class="section-head">
        <h2 id="produkt-rubrik">Fyra profiler, ett gemensamt språk</h2>
        <p class="lead">Alla produkter bygger på samma personprofil. Med ett abonnemang gör du obegränsat antal profiler i alla fyra.</p>
      </header>
      <ul class="product-grid">
        {products.map((p) => (
          <li class="product">
            <div class="photo">
              <Picture src={p.photo} formats={["avif", "webp"]} widths={[480, 720, 960]}
                sizes="(min-width: 48rem) 45vw, 100vw" alt={p.alt} />
            </div>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <a class="text-link" href={p.href}>Läs om {p.name.toLowerCase()}</a>
          </li>
        ))}
      </ul>
      <p class="more">Vill du hellre att vi gör profilerna åt er? <a class="text-link" href="/konsulttjanster/">Se våra konsulttjänster</a></p>
    </div>
  </section>

  <section class="section navy" aria-labelledby="forelasning-rubrik">
    <div class="wrap split split-reverse">
      <div class="photo split-media">
        <Picture src={lecturePhoto} formats={["avif", "webp"]} widths={[480, 720, 1000, 1320]}
          sizes="(min-width: 60rem) 40vw, 100vw"
          alt="En publik sitter i en ljus lokal och lyssnar på en föreläsning om DISC." />
      </div>
      <div class="split-text">
        <h2 id="forelasning-rubrik">Kostnadsfria inspirations&shy;föreläsningar</h2>
        <p class="lead">Under föreläsningen ger vi dig tips och erfarenheter om hur du kan tänka när du möter andra människor i arbetslivet.</p>
        <p class="more"><a class="button button-light" href="/webbinarier/">Se kommande föreläsningar</a></p>
      </div>
    </div>
  </section>

  <section class="clients" aria-labelledby="kund-rubrik">
    <div class="wrap">
      <h2 id="kund-rubrik" class="label">Några av våra kunder</h2>
      <ul class="logo-row">
        {clients.map((c) => (
          <li><Picture src={c.src} formats={["webp"]} widths={[240, 360]} sizes="10rem" alt={c.alt} /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section tint" aria-labelledby="omdome-rubrik">
    <div class="wrap">
      <header class="section-head">
        <h2 id="omdome-rubrik">Vad våra kunder säger</h2>
        <p class="lead"><a class="text-link" href="/omdomen/">Läs alla omdömen</a></p>
      </header>
    </div>
    <div class="rail" tabindex="0" role="region" aria-label="Omdömen, rulla i sidled">
      <ul>
        {quotes.map((q) => (
          <li>
            <figure>
              <blockquote><p>{q.text}</p></blockquote>
              <figcaption><span class="who">{q.name}</span> <span class="org">{q.org}</span></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="distributor-rubrik">
    <div class="wrap section-head flat">
      <h2 id="distributor-rubrik">Bli distributör</h2>
      <div>
        <p class="lead">Arbetar du som coach, konsult eller rekryterare och behöver ett verktyg för att mäta beteenden? Med PulsAnalys breddar du ditt erbjudande och ger dina kunder ett större mervärde.</p>
        <p class="more"><a class="text-link" href="/distributor/">Så blir du distributör</a></p>
      </div>
    </div>
  </section>

  <section class="section contact" aria-labelledby="kontakt-rubrik">
    <div class="wrap section-head flat">
      <h2 id="kontakt-rubrik">Vill du veta mer?</h2>
      <div>
        <p class="lead">Kontakta oss så berättar vi hur PulsAnalys kan hjälpa er.</p>
        <dl class="contact-list">
          <div><dt>Telefon</dt><dd><a href="tel:+46706762375">070-676 23 75</a></dd></div>
          <div><dt>E-post</dt><dd><a href="mailto:info@pulsanalys.se">info@pulsanalys.se</a></dd></div>
        </dl>
        <p class="more"><a class="button" href="/kontakta-oss/">Kontakta oss</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Layout: one 12-column grid. Text blocks start at column 1 or 7; photos are always 3:2. */
  .section { padding-block: var(--section); }
  .tint { background: var(--mist); }
  .navy { background: var(--navy); color: #e6e9f0; }
  .navy h2 { color: #fff; }
  .navy .lead { color: #e6e9f0; }
  .navy :focus-visible { outline-color: #fff; }
  .more { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; align-items: center; }
  .photo { overflow: hidden; border-radius: var(--radius-photo); background: var(--line); aspect-ratio: 3 / 2; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .section-head {
    display: grid;
    gap: 1.25rem var(--gutter);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--navy);
  }
  .section-head.flat { margin-bottom: 0; }
  .section:has(> .flat) { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .section-head .lead { margin: 0; }
  @media (min-width: 60rem) {
    .section-head { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
    .section-head > :first-child { grid-column: 1 / span 5; }
    .section-head > :last-child { grid-column: 7 / span 6; }
  }

  /* Hero */
  .hero { padding-top: clamp(3rem, 7vw, 6rem); }
  .hero-grid { display: grid; gap: 1.75rem var(--gutter); }
  @media (min-width: 60rem) {
    .hero-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: end; }
    .hero h1 { grid-column: 1 / span 7; }
    .hero-side { grid-column: 8 / span 5; }
  }
  .hero h1 { max-width: 18ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 1.75rem; }
  .hero-photo { margin-top: clamp(2.5rem, 5vw, 4rem); aspect-ratio: 3 / 2; }
  @media (min-width: 48rem) { .hero-photo { aspect-ratio: 2 / 1; } }
  .hero-photo :global(img) { object-position: 50% 35%; }

  /* Steps */
  .step-list {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem var(--gutter);
  }
  @media (min-width: 48rem) { .step-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .step-list li { counter-increment: step; }
  .step-list li::before {
    content: counter(step, decimal-leading-zero);
    display: block;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--muted);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .step-list h3 { margin-bottom: 0.5rem; }
  .step-list p { max-width: 38ch; }

  /* Split: photo 5 columns, text 6 columns, one column between. */
  .split { display: grid; gap: 2.5rem var(--gutter); align-items: start; }
  @media (min-width: 60rem) {
    .split { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .split-media { grid-column: 1 / span 5; grid-row: 1; }
    .split-text { grid-column: 7 / span 6; grid-row: 1; }
    .split-reverse .split-media { grid-column: 8 / span 5; }
    .split-reverse .split-text { grid-column: 1 / span 6; }
  }
  .split-text .lead { margin-top: 1.25rem; }
  .list-title { margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .dates { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .dates a {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 160ms var(--ease);
  }
  @media (min-width: 40rem) { .dates a { grid-template-columns: 12rem minmax(0, 1fr); } }
  .dates a:hover, .dates a:focus-visible { background: rgb(46 62 96 / 0.06); }
  .date { font-weight: 600; color: var(--navy); font-variant-numeric: tabular-nums; }
  .what { font-weight: 600; }
  .where { display: block; font-weight: 400; color: var(--muted); font-size: 0.95rem; }

  /* Products: a 2 × 2 grid of equal items. */
  .product-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(2.5rem, 5vw, 4rem) var(--gutter); }
  @media (min-width: 48rem) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .product h3 { margin: 1.5rem 0 0.5rem; font-size: 1.25rem; }
  .product p { max-width: 54ch; margin-bottom: 1rem; }

  /* Button on navy */
  .button-light { background: #fff; color: var(--navy); }
  .button-light:hover { background: #e6e9f0; }

  /* Clients */
  .clients { padding-block: clamp(3rem, 6vw, 4.5rem); border-bottom: 1px solid var(--line); }
  .label { font-family: var(--font); font-size: var(--step-small); font-weight: 600; color: var(--muted); letter-spacing: 0.02em; }
  .logo-row {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 2rem 3rem;
    align-items: center;
  }
  .logo-row li { display: grid; place-items: center; height: 3rem; }
  .logo-row :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 2.25rem;
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: multiply;
    opacity: 0.7;
  }

  /* Quotes */
  .rail {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--margin), (100% - var(--max)) / 2);
    padding-bottom: 1.5rem;
    scrollbar-color: var(--navy) transparent;
  }
  .rail:focus-visible { outline-offset: -3px; }
  .rail ul {
    list-style: none;
    margin: 0;
    padding: 0 max(var(--margin), (100% - var(--max)) / 2);
    display: flex;
    gap: var(--gutter);
    width: max-content;
  }
  .rail li { scroll-snap-align: start; width: min(82vw, 26rem); flex: none; }
  .rail figure { margin: 0; height: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; padding: 1.75rem; background: var(--paper); }
  blockquote { margin: 0; }
  blockquote p { font-family: var(--font-serif); font-size: 1.125rem; line-height: 1.55; color: var(--ink); }
  blockquote p::before { content: "”"; }
  blockquote p::after { content: "”"; }
  .who { display: block; font-weight: 600; color: var(--navy); }
  .org { color: var(--muted); font-size: 0.95rem; }

  /* Contact */
  .contact { background: var(--mist); }
  .contact-list { display: grid; gap: 0.75rem; margin: 1.5rem 0 0; }
  .contact-list div { display: grid; grid-template-columns: 6rem 1fr; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); }
  .contact-list dt { color: var(--muted); }
  .contact-list dd { margin: 0; font-weight: 600; }

  /* Large photos settle into place as they enter. Transform only. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .photo :global(img) {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }
  @keyframes settle {
    from { transform: scale(var(--settle-from, 1.05)); }
    to { transform: scale(1); }
  }
  @media (max-width: 40rem) {
    .photo { --settle-from: 1.025; }
  }
</style>

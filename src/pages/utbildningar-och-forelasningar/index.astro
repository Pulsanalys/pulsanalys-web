---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import DateList from "../../components/DateList.astro";

const groups = [
  { title: "Grundutbildningar DISC", type: "grundutbildning", link: "/grundutbildning-disc/", linkText: "Om grundutbildningen" },
  { title: "Fördjupningskurser DISC", type: "fordjupningskurs", link: "/fordjupning-disc/", linkText: "Om fördjupningskursen" },
  { title: "Föreläsningar och webbinarier", type: "forelasning", link: "/webbinarier/", linkText: "Om föreläsningarna" },
  { title: "Event", type: "event", link: "/event/", linkText: "Om våra event" },
] as const;
---

<Base title="Utbildningar och föreläsningar – kommande datum | PulsAnalys DISC"
  description="Här listar vi alla kommande utbildningstillfällen och inspirationsföreläsningar. Välj ett datum för att läsa mer och skicka in en anmälan.">
  <PageHero heading="Utbildningar och föreläsningar"
    lead="Här finns alla kommande utbildningstillfällen, föreläsningar och event. Välj ett datum för att läsa mer och skicka in en anmälan." />
  {groups.map((g, i) => (
    <section class={`section${i % 2 === 0 ? " tint" : ""}`}>
      <div class="wrap">
        <div class="section-head"><h2>{g.title}</h2><p class="lead"><a class="text-link" href={g.link}>{g.linkText}</a></p></div>
        <DateList types={[g.type]} />
      </div>
    </section>
  ))}
  <CtaBand />
</Base>

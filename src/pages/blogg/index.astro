---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";

const posts = (await getCollection("posts")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = new Intl.DateTimeFormat("sv-SE", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Base title="Blogg och nyhetsbrev | PulsAnalys DISC" description="Nyheter och nyhetsbrev från PulsAnalys AB.">
  <PageHero heading="Blogg" lead="Nyheter och nyhetsbrev från PulsAnalys." />
  <section class="section tint">
    <div class="wrap">
      <ul class="row-list">
        {posts.map((p, i) => (
          <li class={`split${i % 2 ? " reverse" : ""}`}>
            {p.data.photo && (
              <div class="photo">
                <Picture src={p.data.photo} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 60rem) 40vw, 100vw" alt={p.data.alt ?? ""} />
              </div>
            )}
            <div>
              <p class="muted"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt.format(p.data.date)}</time></p>
              <h2><a class="plain-link" href={`/blogg/${p.id}/`}>{p.data.title}</a></h2>
              <p class="lead">{p.data.summary}</p>
              <p class="more"><a class="text-link" href={`/blogg/${p.id}/`}>Läs inlägget<span class="visually-hidden"> {p.data.title}</span></a></p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import DateList from "../components/DateList.astro";
---

<Base title="Webbinarier | PulsAnalys DISC" description="Kostnadsfria inspirationsföreläsningar och webbinarier om DISC. Hur kommunicerar du med dina chefer och kollegor?">
  <PageHero heading="Webbinarier" lead="Vår föreläsare Mia Wernersson berättar om DISC och personlighetsfärgerna för en bättre kommunikation. Du får tips och erfarenheter om hur du kan tänka när du möter andra människor i arbetslivet." crumb={{ href: "/utbildningar-och-forelasningar/", label: "Utbildningar och föreläsningar" }} />
  <section class="section tint">
    <div class="wrap">
      <DateList types={["forelasning"]} empty="Nya föreläsningar publiceras här. Kontakta oss om du vill att vi föreläser för ditt företag." />
      <p class="more"><a class="text-link" href="/konsulttjanster/">Företagsanpassade föreläsningar</a></p>
    </div>
  </section>
  <CtaBand />
</Base>

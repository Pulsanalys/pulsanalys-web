---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import PeopleList from "../components/PeopleList.astro";
import JsonLd from "../components/JsonLd.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Kontakta oss | PulsAnalys DISC"
  description="PulsAnalys AB finns i Stockholm. Nå oss på 070-676 23 75 eller info@pulsanalys.se. Kundsupport: support@pulsanalys.se.">
  <JsonLd data={{
    "@context": "https://schema.org", "@type": "Organization", name: "PulsAnalys AB", url: "https://pulsanalys.se",
    email: "info@pulsanalys.se", telephone: "+46706762375", taxID: "556600-3868",
    address: { "@type": "PostalAddress", streetAddress: "Wollmar Yxkullsgatan 7", postalCode: "118 50", addressLocality: "Stockholm", addressCountry: "SE" },
    sameAs: ["https://www.linkedin.com/company/pulsanalys-ab/", "https://www.facebook.com/PulsAnalysAb/", "https://www.instagram.com/pulsanalysab/"],
  }} />
  <PageHero heading="Kontakta oss" lead="Ring eller mejla oss så berättar vi hur PulsAnalys kan hjälpa er. Är du redan kund och behöver hjälp med systemet når du kundsupporten på support@pulsanalys.se." />
  <section class="section">
    <div class="wrap">
      <ul class="tiles">
        <li class="tile-card"><span class="icon"><Icon name="phone" /></span><span class="label">Telefon</span><a class="value" href="tel:+46706762375">070-676 23 75</a></li>
        <li class="tile-card"><span class="icon"><Icon name="mail" /></span><span class="label">E-post</span><a class="value" href="mailto:info@pulsanalys.se">info@pulsanalys.se</a></li>
        <li class="tile-card"><span class="icon"><Icon name="support" /></span><span class="label">Kundsupport</span><a class="value" href="mailto:support@pulsanalys.se">support@pulsanalys.se</a><span class="hint">För dig som redan är kund</span></li>
        <li class="tile-card"><span class="icon"><Icon name="pin" /></span><span class="label">Besöks- och fakturaadress</span><a class="value" href="https://maps.google.com/?q=Wollmar+Yxkullsgatan+7,+118+50+Stockholm">Wollmar Yxkullsgatan 7<br />118 50 Stockholm</a><span class="hint">Visa på karta</span></li>
      </ul>
      <p class="fineprint">PulsAnalys AB · Organisationsnummer 556600-3868</p>
    </div>
  </section>
  <section class="section tint">
    <div class="wrap">
      <div class="section-head"><h2>Träffa vårt team</h2></div>
      <PeopleList groups={["team", "kontakt"]} />
    </div>
  </section>
</Base>

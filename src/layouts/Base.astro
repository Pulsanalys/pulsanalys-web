---
import "../styles/base.css";

interface Props {
  title: string;
  description?: string;
  lang?: "sv" | "en";
}

const { title, description, lang = "sv" } = Astro.props;
const staging = import.meta.env.PUBLIC_STAGING === "true";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {staging && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Hoppa till innehållet</a>
    <header class="site-header">
      <a class="brand" href="/">PulsAnalys DISC</a>
      <a class="login" href="https://clientarea.pulsanalys.com/">Logga in</a>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>PulsAnalys AB · Org.nr 556600-3868 · <a href="mailto:info@pulsanalys.se">info@pulsanalys.se</a> · 070-676 23 75</p>
    </footer>
  </body>
</html>

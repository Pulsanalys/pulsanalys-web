---
import "../styles/base.css";
import "../styles/sections.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { UI, counterpart, hasPair, langOf } from "../lib/i18n.ts";
import sansLatin from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  lang?: "sv" | "en";
}

const { title, description } = Astro.props;
const lang = Astro.props.lang ?? langOf(Astro.currentLocale);
const pair = counterpart(Astro.url.pathname);
const alt = (p: string) => new URL(p, Astro.site).toString();
const staging = import.meta.env.PUBLIC_STAGING !== "false";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {staging && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {hasPair(Astro.url.pathname) && [
      <link rel="alternate" hreflang="sv" href={alt(pair.sv)} />,
      <link rel="alternate" hreflang="en" href={alt(pair.en)} />,
      <link rel="alternate" hreflang="x-default" href={alt(pair.sv)} />,
    ]}
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#111b35" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "sv" ? "sv_SE" : "en_GB"} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{UI[lang].skip}</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

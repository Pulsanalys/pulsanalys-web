---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

interface Props { groups: ("team" | "kontakt" | "konsult" | "distributor")[] }
const { groups } = Astro.props;
const people = (await getCollection("people", (p) => groups.includes(p.data.group)))
  .sort((a, b) => groups.indexOf(a.data.group) - groups.indexOf(b.data.group) || a.data.order - b.data.order);
const tel = (n: string) => "+46" + n.replace(/\D/g, "").replace(/^0/, "");
const withPhotos = people.some((p) => p.data.photo);
---

<ul class={withPhotos ? "people" : "people people-compact"}>
  {people.map(({ data: p }) => (
    <li>
      {p.photo && (
        <div class="portrait">
          <Picture src={p.photo} formats={["avif", "webp"]} widths={[320, 480, 640]} sizes="(min-width: 60rem) 22vw, 50vw" alt={p.name} />
        </div>
      )}
      <h3>{p.name}</h3>
      <p class="role">{p.area ? (p.group === "distributor" ? p.area : `${p.role}, ${p.area}`) : p.role}</p>
      <p class="contact">
        {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
        {p.phone && <a href={`tel:${tel(p.phone)}`}>{p.phone}</a>}
        {p.linkedin && <a href={p.linkedin}>LinkedIn<span class="visually-hidden"> – {p.name}</span></a>}
      </p>
    </li>
  ))}
</ul>

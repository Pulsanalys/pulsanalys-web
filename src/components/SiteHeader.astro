---
import Logo from "./Logo.astro";
import { UI, counterpart, href, langOf } from "../lib/i18n.ts";

const lang = langOf(Astro.currentLocale);
const t = UI[lang];
const nav = t.nav.map(([path, label]) => ({ href: href(lang, path), label }));
const current = Astro.url.pathname;
const other = counterpart(current)[t.otherLang.lang];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="home" href={href(lang, "/")} aria-label={t.home}>
      <Logo class="logo" />
    </a>

    <nav class="primary" aria-label={t.mainNav}>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={current.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="lang" href={other} hreflang={t.otherLang.lang} lang={t.otherLang.lang}>{t.otherLang.label}</a>
    <a class="login" href="https://clientarea.pulsanalys.com/">{t.login}</a>

    <details class="menu">
      <summary><span>{t.menu}</span></summary>
      <nav aria-label={t.mainNav}>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="https://clientarea.pulsanalys.com/">{t.login}</a></li>
          <li><a href={other} hreflang={t.otherLang.lang} lang={t.otherLang.lang}>{t.otherLang.label}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    isolation: isolate;
  }
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
    opacity: 1;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.75rem;
  }
  .home { display: block; flex: none; color: var(--navy-deep); }
  .home :global(.logo) { width: clamp(9.5rem, 8rem + 4vw, 11.5rem); }

  .primary { margin-left: auto; }
  .primary ul, .menu ul { list-style: none; margin: 0; padding: 0; }
  .primary ul { display: flex; gap: clamp(1rem, 2vw, 1.75rem); }
  .lang { font-size: 0.9688rem; font-weight: 550; text-decoration: none; flex: none; color: var(--muted); }
  .lang:hover, .lang:focus-visible { text-decoration: underline; }
  .primary a, .login {
    font-size: 0.9688rem;
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.5rem;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
    transition: background-size 200ms var(--ease);
  }
  .primary a:hover, .primary a:focus-visible, .primary a[aria-current="page"],
  .login:hover, .login:focus-visible { background-size: 100% 1.5px; }

  .login {
    flex: none;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--navy);
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .login:hover, .login:focus-visible { background: var(--navy-deep); color: #fff; }

  .menu { display: none; margin-left: auto; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    color: var(--navy);
    padding: 0.6rem 0;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary::after {
    content: "";
    width: 0.55em;
    height: 0.55em;
    margin-left: 0.5em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform 160ms var(--ease);
  }
  .menu[open] summary::after { transform: translateY(0.1em) rotate(-135deg); }
  .menu nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 0.5rem var(--margin) 1.5rem;
    box-shadow: var(--shadow-m);
  }
  .menu nav a {
    display: block;
    padding: 0.75rem 0;
    font-size: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 66rem) {
    .primary, .login, .lang { display: none; }
    .menu { display: block; }
  }

</style>

---
import { getCollection, render } from "astro:content";
import type { ContentItem } from "../lib/content-item.ts";
import Base from "../layouts/Base.astro";
import PageHero from "./PageHero.astro";
import CtaBand from "./CtaBand.astro";
import DateList from "./DateList.astro";
import PeopleList from "./PeopleList.astro";
import JsonLd from "./JsonLd.astro";
import { UI, href, langOf } from "../lib/i18n.ts";


const { item } = Astro.props as { item: ContentItem };
const lang = langOf(Astro.currentLocale);
const t = UI[lang].page;
const { Content } = await render(item.entry);
const site = "PulsAnalys DISC";
const sameLang = (id: string) => (lang === "en") === id.startsWith("en/");
const otherProducts = item.kind === "product"
  ? (await getCollection("products")).filter((p) => p.id !== item.entry.id && sameLang(p.id)).sort((a, b) => a.data.order - b.data.order)
  : [];
---

{item.kind === "product" && (() => {
  const d = item.entry.data;
  return (
    <Base title={`${d.title} – ${d.tagline} | ${site}`} description={d.description}>
      <PageHero heading={d.title} lead={d.summary} photo={d.photo} alt={d.alt} crumb={{ href: href(lang, "/produkter/"), label: t.products }}>
        <p class="tagline">{d.tagline}</p>
      </PageHero>
      <section class="section">
        <div class="wrap with-aside">
          <div class="prose"><Content /></div>
          <aside class="aside-card">
            <h2 class="aside-title">{t.usedFor}</h2>
            <ul class="ticks">{d.uses.map((u) => <li>{u}</li>)}</ul>
          </aside>
        </div>
      </section>
      <section class="section tint">
        <div class="wrap">
          <div class="section-head"><h2>{d.stepsTitle}</h2></div>
          <ol class="numbered">{d.steps.map((s) => <li><p>{s}</p></li>)}</ol>
          <p class="more">
            <a class="button" href={href(lang, "/grundutbildning-disc/")}>{t.learnTool}</a>
            <a class="text-link" href={href(lang, "/konsulttjanster/")}>{t.letUs}</a>
          </p>
        </div>
      </section>
      <section class="section">
        <div class="wrap">
          <div class="section-head"><h2>{t.moreProfiles}</h2></div>
          <ul class="card-grid">
            {otherProducts.map((p) => (
              <li>
                <h3><a href={lang === "en" ? `/en/${p.id.slice(3)}/` : `/${p.id}/`}>{p.data.title}</a></h3>
                <p>{p.data.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
      <CtaBand />
    </Base>
  );
})()}

{item.kind === "course" && (() => {
  const d = item.entry.data;
  return (
    <Base title={`${d.title} | ${site}`} description={d.description}>
      <JsonLd data={{
        "@context": "https://schema.org", "@type": "Course", name: d.title, description: d.description,
        provider: { "@type": "Organization", name: "PulsAnalys AB", sameAs: "https://pulsanalys.se" },
        inLanguage: "sv",
      }} />
      <PageHero heading={d.title} lead={d.summary} photo={d.photo} alt={d.alt} crumb={{ href: href(lang, "/kurser/"), label: t.courses }}>
        <div class="actions">
          <a class="button" href={href(lang, d.bookingPage)}>{t.seeDates}</a>
          {d.price && <span class="price">{d.price}</span>}
        </div>
      </PageHero>
      <section class="section">
        <div class="wrap"><div class="prose"><Content /></div></div>
      </section>
      <section class="section tint">
        <div class="wrap">
          <div class="section-head"><h2>{t.programme}</h2></div>
          <ul class="card-grid">
            {d.programme.map((block) => (
              <li>
                <h3>{block.title}</h3>
                <ul class="plain">{block.items.map((i) => <li>{i}</li>)}</ul>
              </li>
            ))}
          </ul>
        </div>
      </section>
      {d.eventType && (
        <section class="section">
          <div class="wrap">
            <div class="section-head"><h2>{t.upcoming}</h2>{d.price && <p class="lead">{t.price}: {d.price}</p>}</div>
            <DateList types={[d.eventType]} />
          </div>
        </section>
      )}
      <CtaBand />
    </Base>
  );
})()}

{item.kind === "page" && (() => {
  const d = item.entry.data;
  return (
    <Base title={`${d.title} | ${site}`} description={d.description}>
      {d.faq && (
        <JsonLd data={{
          "@context": "https://schema.org", "@type": "FAQPage",
          mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
        }} />
      )}
      <PageHero heading={d.heading} lead={d.lead} photo={d.photo} alt={d.alt} />
      {(item.entry.body?.trim() || d.faq) && (
        <section class="section">
          <div class="wrap">
            {d.faq && (
              <div class="faq">
                {d.faq.map((f) => (<details><summary>{f.q}</summary><div class="answer"><p>{f.a}</p></div></details>))}
              </div>
            )}
            <div class="prose"><Content /></div>
          </div>
        </section>
      )}
      {d.people && (
        <section class="section tint">
          <div class="wrap">
            {d.peopleHeading && <div class="section-head"><h2>{d.peopleHeading}</h2></div>}
            <PeopleList groups={[d.people]} />
          </div>
        </section>
      )}
      <CtaBand />
    </Base>
  );
})()}
